# Copy to .env (never commit .env)
GOOGLE_API_KEY=
# Optional: override the model, per-call timeout, thinking level
# WFX_LLM_MODEL=gemini-3.1-flash-lite
# WFX_LLM_TIMEOUT_S=30
# WFX_LLM_THINKING=MINIMAL
# In containers, mount the key as a file instead: GOOGLE_API_KEY_FILE=/run/secrets/google_api_key
